{
  "name": "Ramitos Back",
  // compose.override.yml is for personal tweaks (gitignored); it's created empty if missing.
  // Runs on the host under sh or cmd.exe, so no `touch`: the git call prints nothing, the >> creates the file
  "initializeCommand": "git config --get devcontainer.none >> .devcontainer/compose.override.yml || exit 0",
  "dockerComposeFile": ["../docker-compose.yml", "compose.yml", "compose.override.yml"],
  "service": "dev",
  // Everything from the root stack except the `ramitos` app image, which you run from sbt instead
  "runServices": ["db", "migration", "db-inserts", "db-seed", "dev"],
  "workspaceFolder": "/workspaces/ramitos-back",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000, "db:5432"],
  "portsAttributes": {
    "8000": { "label": "ramitos" },
    "db:5432": { "label": "postgres" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["scalameta.metals", "scala-lang.scala"],
      "settings": {
        "metals.javaHome": "/opt/java",
        "metals.sbtScript": "/usr/local/bin/sbt"
      }
    }
  }
}
